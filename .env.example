# --- Base ---
DATABASE_URL="file:./dev.db"

# --- NextAuth ---
# Génère une clé : openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth (Drive + Login) ---
# Crée un projet sur https://console.cloud.google.com
# Active : Google Drive API
# OAuth consent screen : ajoute le scope https://www.googleapis.com/auth/drive.readonly
# Crée des credentials OAuth Web :
#   - JS origin: http://localhost:3000
#   - Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Anthropic (Claude) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""
# Optionnel : modèle par défaut (claude-sonnet-4-6 ou claude-opus-4-7)
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- App ---
# Date d'examen (ISO) pour le compte à rebours du dashboard
NEXT_PUBLIC_EXAM_DATE=""

# Mode mono-utilisateur : si défini, seul cet email peut se connecter.
# Laisse vide pour autoriser n'importe quel compte Google.
SINGLE_USER_EMAIL=""

# (optionnel) URL du dossier Drive racine, pré-remplie au premier import.
# Format : https://drive.google.com/drive/folders/XXXXXXXXX
DRIVE_FOLDER_URL=""
